# Firebase (client)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=

# Public site URL (used in shipment notification emails)
NEXT_PUBLIC_SITE_URL=https://atlasswiftlogistics.com

# SMTP — outbound shipment emails from info@atlasswiftlogistics.com
SMTP_HOST=mail.atlasswiftlogistics.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@atlasswiftlogistics.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=info@atlasswiftlogistics.com

# IMAP — used to save Sent copies and deliver self-notifications directly to Inbox
# Typically the same host as SMTP, port 993 (TLS) or 143 (STARTTLS)
IMAP_HOST=mail.atlasswiftlogistics.com
IMAP_PORT=993

# Admin notification email — receives a copy on every shipment create/update
ADMIN_EMAIL=info@atlasswiftlogistics.com
